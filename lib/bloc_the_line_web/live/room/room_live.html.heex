<div style="min-height: 100vh; padding: 2rem;">
  <div style="max-width: 1000px; margin: 0 auto;">
    <!-- Header -->
    <div style="padding: 1rem; border: 1px solid #000; margin-bottom: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h1 style="font-size: 1.5rem; font-weight: bold;">Room: <%= @room_code %></h1>
          <p>Playing as: <%= @player_name %></p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <button
            phx-click="copy_link"
            id="copy-button"
            phx-hook="CopyToClipboard"
            data-text={url(~p"/room/#{@room_code}")}
            style="padding: 0.5rem 1rem; border: 1px solid #000; background: none; cursor: pointer;"
          >
            <%= if @copied, do: "✓ Copied!", else: "Copy Invite Link" %>
          </button>
          <.link
            navigate={~p"/"}
            style="padding: 0.5rem 1rem; border: 1px solid #000; background: none; text-decoration: none; cursor: pointer;"
          >
            Leave Room
          </.link>
        </div>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 3fr; gap: 1.5rem;">
      <!-- Players List -->
      <div style="border: 1px solid #000; padding: 1rem;">
        <h2 style="font-size: 1.25rem; font-weight: bold; margin-bottom: 1rem;">
          Players (<%= map_size(@players) %>)
        </h2>

        <div>
          <%= for {_id, player} <- @players do %>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
              <div style="width: 32px; height: 32px; border: 1px solid #000; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                <%= String.first(player.name) %>
              </div>
              <div>
                <p style="margin: 0;"><%= player.name %></p>
                <%= if player.id == @player_id do %>
                  <p style="margin: 0; font-size: 0.75rem;">(You)</p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Game Area -->
      <div style="border: 1px solid #000; padding: 1rem;">
        <h2 style="font-size: 1.25rem; font-weight: bold; text-align: center; margin-bottom: 1rem;">
          Blokus Board
        </h2>
        <.blokus_board board={@board} />
      </div>
    </div>
  </div>
</div>
