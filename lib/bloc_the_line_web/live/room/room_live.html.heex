<div class="min-h-screen bg-gray-100 p-8">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-3xl font-bold text-gray-800">Room: {@room_code}</h1>

          <div class="mt-1 flex items-center gap-3">
            <span class="text-gray-600">My name is:</span>

            <%= if @editing_name do %>
              <form phx-submit="save_name" class="flex items-center gap-2">
                <input
                  type="text"
                  name="new_name"
                  value={@player_name}
                  required
                  class="border px-2 py-1 rounded bg-gray-100 text-black"
                />
                <button
                  type="submit"
                  class="bg-blue-500 text-white px-3 py-1 rounded border border-black"
                >
                  Save
                </button>
                <button
                  type="button"
                  phx-click="cancel_edit_name"
                  class="px-3 py-1 rounded border border-black bg-red-500 text-white hover:bg-red-600"
                >
                  Cancel
                </button>
              </form>
            <% else %>
              <div class="flex items-center gap-2">
                <span class="font-semibold text-gray-800">{@player_name}</span>
                <button
                  type="button"
                  phx-click="start_edit_name"
                  class="text-sm text-blue-600 underline"
                >
                  Edit
                </button>
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex gap-3">
          <button
            phx-click="copy_link"
            id="copy-button"
            phx-hook="CopyToClipboard"
            data-text={url(~p"/room/#{@room_code}")}
            class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg transition border border-black"
          >
            {if @copied, do: "✓ Copied!", else: "Copy Invite Link"}
          </button>
          <button
            phx-click="toggle_public"
            class="bg-green-500 hover:bg-green-600 text-white px-6 py-2 rounded-lg transition border border-black"
          >
            {if @public, do: "Make Private", else: "Make Public"}
          </button>
          <.link
            navigate={~p"/"}
            class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg transition border border-black"
          >
            Leave Room
          </.link>
        </div>
      </div>
    </div>

    <!-- Timer Display -->
    <%= if @game_started do %>
      <div class="bg-white rounded-lg shadow-lg p-4 mb-6 text-center">
        <div class="text-2xl font-bold text-gray-800">
          Time Remaining: <span class={[
            "font-mono",
            @timer_seconds <= 10 && "text-red-600",
            @timer_seconds > 10 && @timer_seconds <= 30 && "text-yellow-600",
            @timer_seconds > 30 && "text-green-600"
          ]}>{@timer_seconds}s</span>
        </div>
      </div>
    <% end %>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      <!-- Players List -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h2 class="text-xl font-semibold mb-4 text-gray-800">Players ({map_size(@players)})</h2>
          <!-- Ready Button -->
          <div class="space-y-3">
            <%= for {id, player} <- @players do %>
              <div class={
                cond do
                  player.id == @player_id ->
                    "flex items-center gap-3 bg-gray-50 rounded-lg p-3 border-4 shadow-md transition transform " <>
                      case player.color do
                        1 -> "border-blue-400"
                        2 -> "border-red-400"
                        3 -> "border-green-400"
                        4 -> "border-yellow-400"
                        _ -> "border-gray-300"
                      end

                  true ->
                    "flex items-center gap-3 bg-gray-50 rounded-lg p-3 border border-gray-200 transition"
                end
              }>
                <div class={"w-10 h-10 rounded-full flex items-center justify-center text-white font-bold #{
                  case player.color do
                    1 -> "bg-blue-500"
                    2 -> "bg-red-500"
                    3 -> "bg-green-500"
                    4 -> "bg-purple-500"
                    _ -> "bg-gray-500"
                  end
                }"}>
                  {BlocTheLineWeb.RoomLive.get_avatar_initial(player.name)}
                </div>
                <div class="flex-1">
                  <p class="font-semibold text-gray-800">
                    {player.name}
                    <span class="text-sm text-gray-500">(P{player.color})</span>
                  </p>

                  <p class="text-xs text-gray-500">
                    Pieces placed: {case player.color do
                      1 -> Map.get(@board.count_map, :p1, 0)
                      2 -> Map.get(@board.count_map, :p2, 0)
                      3 -> Map.get(@board.count_map, :p3, 0)
                      4 -> Map.get(@board.count_map, :p4, 0)
                      _ -> 0
                    end}
                  </p>

                  <%= if player.id == @player_id do %>
                    <p class="text-xs text-blue-600">You</p>
                  <% end %>
                  <p class="text-xs">
                    {if player.ready, do: "Ready", else: "Not Ready"}
                  </p>
                  <%= if id == @player_id do %>
                    <button
                      phx-click="toggle_ready"
                      phx-value-ready={"#{if player.ready == true, do: "false", else: "true"}"}
                      class="ml-2 px-2 py-1 rounded bg-blue-500 text-white"
                    >
                      {if player.ready == true, do: "Unready", else: "Ready"}
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
            <!-- Game Start Button -->
            <%= if @player_id == @host_id and all_ready?(@players) and not @game_started do %>
              <button
                phx-click="start_game"
                class="mt-4 px-4 py-2 rounded-lg bg-green-600 hover:bg-green-700 text-white font-bold shadow-lg transition"
              >
                Start Game
              </button>
            <% else %>
              <div class="mt-4 text-center text-gray-700 font-semibold">
                <% ready_count =
                  Enum.count(@players, fn {_id, player} -> player.ready == true end) %>
                <% total_count = map_size(@players) %> Players Ready: {ready_count} / {total_count}
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <!-- Game Area -->
      <div class="lg:col-span-3">
        <%= if @game_started do %>
          <div class="bg-white rounded-lg shadow-lg p-8 relative pt-20">
            <!-- Game Over Overlay -->
            <%= if @game_over do %>
              <div class="absolute inset-0 bg-black/60 flex items-center justify-center z-50">
                <div class="bg-white rounded-lg shadow-xl px-8 py-6 text-center border border-black">
                  <h2 class="text-2xl font-bold mb-2">Game Over</h2>
                  <p class="mb-4 text-gray-700">
                    {case @game_over_reason do
                      :timeout -> "Time's up!"
                      "timeout" -> "Time's up!"
                      _ -> "The game has ended."
                    end}
                  </p>
                  <p class="text-sm text-gray-500">
                    You can stay in this room or create a new one from the lobby.
                  </p>
                </div>
              </div>
            <% end %>
            <!-- Wrapper so cards & board share the same positioning context -->
            <div class="inline-block mx-auto">
              
<!-- DYNAMIC PLAYER CARDS -->
              <% players_list =
                @players
                |> Enum.sort_by(fn {_id, p} -> p.color end)

              num_players = length(players_list)

              corner_positions =
                case num_players do
                  1 -> ["top-0 left-0"]
                  2 -> ["top-0 left-0", "bottom-0 right-0"]
                  3 -> ["top-0 left-0", "top-0 right-0", "bottom-0 left-0"]
                  4 -> ["top-0 left-0", "top-0 right-0", "bottom-0 left-0", "bottom-0 right-0"]
                end %>

              <%= for {{_id, player}, idx} <- Enum.with_index(players_list) do %>
                <% pos = Enum.at(corner_positions, idx) %>

                <% icon =
                  case player.color do
                    1 -> "/images/icons/blue_wizard.png"
                    2 -> "/images/icons/red_wizard.png"
                    3 -> "/images/icons/green_wizard.png"
                    4 -> "/images/icons/purple_wizard.png"
                    _ -> "/images/icons/default_wizard.png"
                  end %>

                <div class={
      "player-card absolute #{pos} m-2 bg-white/90 rounded-lg shadow-md 
       px-3 py-2 flex items-center gap-2 z-50"
    }>
                  <img
                    src={icon}
                    alt="Player Icon"
                    class="w-10 h-10 object-contain shadow"
                  />

                  <div class="text-xs leading-tight">
                    <div class="font-semibold text-gray-800">
                      {player.name}
                      <span class="ml-1 text-[10px] text-gray-500">(P{player.color})</span>
                    </div>

                    <div class="text-gray-700">
                      Score: <span class="font-semibold">{Map.get(player, :score, 0)}</span>
                    </div>

                    <div class="text-gray-700">
                      Held:
                      <span class="font-semibold">
                        {BlocTheLine.Rooms.get_assigned_piece(@room_code, player.id) || "None"}
                      </span>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
            <div
              id="moving-block-container"
              phx-hook="MovingBlock"
              data-pieces={Jason.encode!(@pieces)}
              data-assigned-piece={@assigned_piece}
              data-rows="20"
              data-cols="20"
              data-my-corner={Jason.encode!(Tuple.to_list(@my_corner))}
              data-last-placed={
                if @last_placed_position,
                  do: Jason.encode!(Tuple.to_list(@last_placed_position)),
                  else: "null"
              }
              style="position: relative; display: inline-block;"
            >
              <.blokus_board board={@board} />
              <div
                class="moving-block"
                data-row="0"
                data-col="0"
                data-player-color={@player_color}
              >
              </div>
              
<!-- Corner indicators for each player -->
              <%= for {player_id, {col, row}} <- @player_corners do %>
                <% player = @players[player_id] %>
                <%= if player do %>
                  <div
                    class="corner-marker"
                    style={
                      "position: absolute; " <>
                      "left: #{col * 32}px; " <>
                      "top: #{row * 32}px; " <>
                      "width: 32px; height: 32px; " <>
                      "border: 3px solid " <> 
                      (case player.color do
                        1 -> "#3b82f6"
                        2 -> "#ef4444"
                        3 -> "#22c55e"
                        4 -> "#a855f7"
                        _ -> "#6b7280"
                      end) <> "; " <>
                      "border-radius: 4px; " <>
                      "display: flex; align-items: center; justify-content: center; " <>
                      "font-weight: bold; font-size: 14px; color: white; " <>
                      "background: rgba(" <>
                      (case player.color do
                        1 -> "59, 130, 246"
                        2 -> "239, 68, 68"
                        3 -> "34, 197, 94"
                        4 -> "168, 85, 247"
                        _ -> "107, 114, 128"
                      end) <> ", 0.3); " <>
                      "pointer-events: none; z-index: 5;"
                    }
                  >
                    P{player.color}
                  </div>
                <% end %>
              <% end %>
              
<!-- leave in for use with JS measurements -->
              <div
                class="blokus-tile w-8 h-8"
                style="position: absolute; opacity: 0; pointer-events: none;"
              >
              </div>
            </div>

            <div class="mt-4 text-center text-sm text-gray-600">
              <p>
                Use WASD to move | R/E to rotate | F/V to flip | SPACE to place
              </p>
              <%= if @assigned_piece do %>
                <p class="mt-2 font-semibold text-blue-600">
                  Current Piece: {@assigned_piece}
                </p>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="bg-white rounded-lg shadow-lg p-8">
            <div class="text-center py-12">
              <h2 class="text-2xl font-bold text-gray-800 mb-4">Waiting for game to start...</h2>
              <p class="text-gray-600">
                The host will start the game when all players are ready.
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
