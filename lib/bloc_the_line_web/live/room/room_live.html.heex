<div class="min-h-screen bg-neutral-900 p-8">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="p-6 mb-6">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-3xl font-bold">Room: {@room_code}</h1>

          <div class="mt-1 flex items-center gap-3">
            <span class="">My name is:</span>

            <%= if @editing_name do %>
              <form phx-submit="save_name" class="flex items-center gap-2">
                <input
                  type="text"
                  name="new_name"
                  value={@player_name}
                  required
                  class="px-2 py-1 rounded bg-neutral-800"
                />
                <button
                  type="submit"
                  class="text-sm bg-blue-700 text-white px-3 py-1 rounded border border-black hover:bg-blue-600"
                >
                  Save
                </button>
                <button
                  type="button"
                  phx-click="cancel_edit_name"
                  class="text-sm px-3 py-1 rounded border border-black bg-red-700 hover:bg-red-600"
                >
                  Cancel
                </button>
              </form>
            <% else %>
              <div class="flex items-center gap-2">
                <span class="font-semibold">{@player_name}</span>
                <button
                  type="button"
                  phx-click="start_edit_name"
                  class="text-sm text-blue-600 underline"
                >
                  Edit
                </button>
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex gap-3">
          <button
            phx-click="copy_link"
            id="copy-button"
            phx-hook="CopyToClipboard"
            data-text={url(~p"/room/#{@room_code}")}
            class="text-sm bg-blue-700 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition"
          >
            {if @copied, do: "✓ Copied!", else: "Copy Invite Link"}
          </button>
          <button
            phx-click="toggle_public"
            class="text-sm bg-green-700 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition"
          >
            {if @public, do: "Make Private", else: "Make Public"}
          </button>
          <.link
            navigate={~p"/"}
            class="text-sm bg-red-700 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition"
          >
            Leave Room
          </.link>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      <!-- Players List -->
      <div class="lg:col-span-1">
        <div class="p-6">
          <h2 class="text-xl font-semibold mb-4">Players ({map_size(@players)})</h2>
          <!-- Ready Button -->
          <div class="flex flex-col space-y-3">
            <%= for {id, player} <- @players do %>
            <div class={
              "flex items-center gap-6 p-3 transition rounded " <>
                if player.id == @player_id do
                  "border-4 " <>
                    case player.color do
                      1 -> "border-blue-500"
                      2 -> "border-red-500"
                      3 -> "border-green-500"
                      4 -> "border-purple-500"
                      _ -> "border-gray-500"
                    end
                else
                  ""
                end
            }>
              
                <div class={"w-10 h-10 rounded-full flex items-center justify-center text-white font-bold #{
                  case player.color do
                    1 -> "bg-blue-500"
                    2 -> "bg-red-500"
                    3 -> "bg-green-500"
                    4 -> "bg-purple-500"
                    _ -> "bg-gray-500"
                  end
                }"}>
                  {BlocTheLineWeb.RoomLive.get_avatar_initial(player.name)}
                </div>
                <div class="flex flex-col">
                  <p class="font-semibold">
                    {player.name}
                    <span class="text-sm text-gray-400">(P{player.color})</span>
                  </p>

                  <p class="text-xs text-gray-400">
                    Pieces placed: {case player.color do
                      1 -> Map.get(@board.count_map, :p1, 0)
                      2 -> Map.get(@board.count_map, :p2, 0)
                      3 -> Map.get(@board.count_map, :p3, 0)
                      4 -> Map.get(@board.count_map, :p4, 0)
                      _ -> 0
                    end}
                  </p>

                  <%= if player.id == @player_id do %>
                    <p class="text-xs text-blue-500">You</p>
                  <% end %>
                  <div class="mt-2">
                    <p class="text-xs mb-1">
                      {if player.ready, do: "Ready", else: "Not Ready"}
                    </p>
                    <%= if id == @player_id do %>
                      <button
                        phx-click="toggle_ready"
                        phx-value-ready={"#{if player.ready == true, do: "false", else: "true"}"}
                        class="text-sm px-2 py-1 rounded bg-blue-700 text-white hover:bg-blue-600"
                      >
                        {if player.ready == true, do: "Unready", else: "Ready"}
                      </button>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
            <!-- Game Start Button -->
            <%= if @player_id == @host_id and all_ready?(@players) and not @game_started do %>
              <button
                phx-click="start_game"
                class="mt-4 px-4 py-2 rounded-lg bg-green-600 hover:bg-green-700 text-white font-bold transition"
              >
                Start Game
              </button>
            <% else %>
              <div class="mt-4 text-center font-semibold">
                <% ready_count =
                  Enum.count(@players, fn {_id, player} -> player.ready == true end) %>
                <% total_count = map_size(@players) %> Players Ready: {ready_count} / {total_count}
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <!-- Game Area -->
      <div class="lg:col-span-3">
        <%= if @game_started do %>
          <div class="flex flex-col items-center p-8 relative pt-20">
            <!-- Wrapper so cards & board share the same positioning context -->
            <div class="inline-block mx-auto">
              
      <!-- GAME PLAYER CARDS  -->
              <% players_list =
                @players
                |> Enum.sort_by(fn {_id, p} -> p.color end)

              num_players = length(players_list)

              corner_positions =
                case num_players do
                  1 -> ["top-0 left-0"]
                  2 -> ["top-0 left-0", "bottom-0 right-0"]
                  3 -> ["top-0 left-0", "top-0 right-0", "bottom-0 left-0"]
                  4 -> ["top-0 left-0", "top-0 right-0", "bottom-0 left-0", "bottom-0 right-0"]
                end %>

              <%= for {{_id, player}, idx} <- Enum.with_index(players_list) do %>
                <% pos = Enum.at(corner_positions, idx) %>

                <% icon =
                  case player.color do
                    1 -> "/images/icons/blue_wizard.png"
                    2 -> "/images/icons/red_wizard.png"
                    3 -> "/images/icons/green_wizard.png"
                    4 -> "/images/icons/purple_wizard.png"
                    _ -> "/images/icons/default_wizard.png"
                  end %>

                <div class={"player-card absolute #{pos} m-2 px-3 py-2 flex items-center gap-2 z-50"}>
                  <img
                    src={icon}
                    alt="Player Icon"
                    class="w-10 h-10 object-contain shadow"
                  />

                  <div class="text-xs leading-tight">
                    <div class="font-semibold">
                      {player.name}
                      <span class="ml-1 text-[10px]">(P{player.color})</span>
                    </div>

                    <div class="text-gray-400">
                      Score: {Map.get(player, :score, 0)}
                    </div>
                      <div class="text-gray-400">
                        Held:
                        <span>
                        <%= BlocTheLine.Rooms.get_assigned_piece(@room_code, player.id) || "None" %>
                       </span>
                      </div>
                  </div>
                </div>
              <% end %>
            </div>
            <div
              id="moving-block-container"
              phx-hook="MovingBlock"
              data-pieces={Jason.encode!(@pieces)}
              data-assigned-piece={@assigned_piece}
              data-rows="20"
              data-cols="20"
              data-my-corner={Jason.encode!(Tuple.to_list(@my_corner))}
              data-last-placed={
                if @last_placed_position,
                  do: Jason.encode!(Tuple.to_list(@last_placed_position)),
                  else: "null"
              }
              style="position: relative; display: inline-block;"
            >
              <.blokus_board board={@board} />
              <div
                class="moving-block"
                data-row="0"
                data-col="0"
                data-player-color={@player_color}
              >
              </div>
              
<!-- Corner indicators for each player -->
              <%= for {player_id, {col, row}} <- @player_corners do %>
                <% player = @players[player_id] %>
                <%= if player do %>
                  <div
                    class="corner-marker"
                    style={
                      "position: absolute; " <>
                      "left: #{col * 32}px; " <>
                      "top: #{row * 32}px; " <>
                      "width: 32px; height: 32px; " <>
                      "border: 3px solid " <> 
                      (case player.color do
                        1 -> "#3b82f6"
                        2 -> "#ef4444"
                        3 -> "#22c55e"
                        4 -> "#a855f7"
                        _ -> "#6b7280"
                      end) <> "; " <>
                      "border-radius: 4px; " <>
                      "display: flex; align-items: center; justify-content: center; " <>
                      "font-weight: bold; font-size: 14px; color: white; " <>
                      "background: rgba(" <>
                      (case player.color do
                        1 -> "59, 130, 246"
                        2 -> "239, 68, 68"
                        3 -> "34, 197, 94"
                        4 -> "168, 85, 247"
                        _ -> "107, 114, 128"
                      end) <> ", 0.3); " <>
                      "pointer-events: none; z-index: 5;"
                    }
                  >
                    P{player.color}
                  </div>
                <% end %>
              <% end %>
              
<!-- leave in for use with JS measurements -->
              <div
                class="blokus-tile w-8 h-8"
                style="position: absolute; opacity: 0; pointer-events: none;"
              >
              </div>
            </div>

            <div class="mt-4 text-center text-sm text-gray-400">
              <p>
                Use WASD to move | R/E to rotate | F/V to flip | SPACE to place
              </p>
              <%= if @assigned_piece do %>
                <p class="mt-2 font-semibold text-blue-500">
                  Current Piece: {@assigned_piece}
                </p>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="p-8">
            <div class="text-center py-12">
              <h2 class="text-2xl font-bold mb-4">Waiting for game to start...</h2>
              <p class="text-gray-400">
                The host will start the game when all players are ready.
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
