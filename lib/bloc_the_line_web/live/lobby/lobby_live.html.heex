<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1rem;">
  <div style="width: 100%; max-width: 400px;">
    <h1 style="text-align: center; font-size: 2rem; margin-bottom: 0.5rem;">Bloc the Line</h1>

    <p style="text-align: center; margin-bottom: 1.5rem;">Blokus Multiplayer</p>

    <%= if Phoenix.Flash.get(@flash, :error) do %>
      <div
        role="alert"
        style="border:1px solid #fca5a5; background:#fff1f2; color:#991b1b; padding:0.75rem; margin-bottom:1rem; border-radius:4px;"
      >
        <strong style="display:block; margin-bottom:0.25rem;">Error</strong>
        {Phoenix.Flash.get(@flash, :error)}
      </div>
    <% end %>

    <%= if Phoenix.Flash.get(@flash, :info) do %>
      <div
        role="status"
        style="border:1px solid #bbf7d0; background:#f0fdf4; color:#14532d; padding:0.75rem; margin-bottom:1rem; border-radius:4px;"
      >
        <strong style="display:block; margin-bottom:0.25rem;">Notice</strong>
        {Phoenix.Flash.get(@flash, :info)}
      </div>
    <% end %>
    <div style="margin-bottom: 1.5rem;">
      <form phx-change="update_player_name" style="margin-bottom: 1.5rem;">
        <label style="display: block; margin-bottom: 0.25rem; font-weight: 500;">Your Name</label>
        <input
          type="text"
          name="player_name"
          placeholder="Enter your name to continue"
          value={@player_name}
          style="width: 100%; padding: 0.5rem; border: 1px solid #aaa;"
          maxlength="30"
          autofocus
        />
      </form>
    </div>

    <h2 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Public Rooms</h2>

    <div style="margin-bottom: 1rem;">
      <%= if Enum.empty?(@public_rooms || []) do %>
        <p style="color: #666;">No public rooms right now.</p>
      <% else %>
        <div style="display: grid; gap: 0.5rem;">
          <%= if @prefill_notice do %>
            <div
              role="alert"
              style="border:1px solid #f59e0b; background:#fffbeb; color:#92400e; padding:0.5rem; margin-bottom:0.5rem; border-radius:4px;"
            >
              <strong style="display:block; margin-bottom:0.25rem;">Notice</strong> {@prefill_notice}
            </div>
          <% end %>

          <%= for room <- @public_rooms do %>
            <div style="display:flex; justify-content:space-between; align-items:center; padding:0.5rem; border:1px solid #ddd; gap:0.75rem; flex-wrap:nowrap;">
              <div style="min-width:0; flex:1; display:flex; flex-direction:column;">
                <strong style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                  {room.room_code}
                </strong>
                <div style="font-size:0.85rem; color:#666;">Players: {length(room.players)}</div>
              </div>

              <div style="white-space:nowrap;">
                <button
                  id={"join_public_#{room.room_code}"}
                  phx-hook="JoinPublic"
                  data-room-code={room.room_code}
                  type="button"
                  title="Join as guest (or use name above)"
                  style="cursor: pointer;"
                  class="w-full p-2 border border-black bg-transparent cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                  disabled={String.trim(@player_name || "") == ""}
                >
                  Join
                </button>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Create New Room</h2>

      <form phx-submit="create_room">
        <input type="hidden" name="player_name" value={@player_name} />
        <button
          type="submit"
          class="w-full p-2 border border-black bg-transparent cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          style="width: 100%; padding: 0.5rem; border: 1px solid #000; background: none; cursor: pointer;"
          disabled={String.trim(@player_name || "") == ""}
        >
          Create Room
        </button>
      </form>
    </div>

    <div>
      <h2 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Join Existing Room</h2>

      <form phx-submit="join_room" phx-hook="JoinRoomValidation" id="join-room-form">
        <input type="hidden" name="player_name" value={@player_name} />
        <input
          type="text"
          name="room_code"
          placeholder="Room Code"
          value={@room_code}
          phx-change="update_room_code"
          style="width: 100%; padding: 0.5rem; border: 1px solid #aaa; margin-bottom: 0.5rem; text-transform: uppercase;"
          maxlength="6"
          required
        />
        <button
          type="submit"
          class="w-full p-2 border border-black bg-transparent cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          style="width: 100%; padding: 0.5rem; border: 1px solid #000; background: none; cursor: pointer;"
          disabled={String.trim(@player_name || "") == ""}
        >
          Join Room
        </button>
      </form>
    </div>
  </div>
</div>
